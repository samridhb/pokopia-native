#version 450
#extension GL_KHR_shader_subgroup_vote : require
// vkspv_sg32_emulate's test (t_vk_sg32.c): Any and All in a module without the lane index, which the rewrite then declares
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer In { uint x[]; } src;
layout(std430, set = 0, binding = 1) buffer Out { uint o[]; } dst;
void main() {
    uint i = gl_GlobalInvocationID.x, x = src.x[i];
    if (x == 7u) return;
    dst.o[i * 2u] = subgroupAny(x == 0u) ? 1u : 0u;
    dst.o[i * 2u + 1u] = subgroupAll(x != 3u) ? 1u : 0u;
}
